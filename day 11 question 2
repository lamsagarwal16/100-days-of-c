Q22: Write a program to find profit or loss percentage given cost price and selling price.

#include<stdio.h>
int main()
{
	int cp,sp,profit,per,loss;
	printf("enter the cp\n",cp);
	scanf("%d",&cp);
	printf("enter the sp\n",sp);
	scanf("%d",&sp);
	if(sp>cp)
{
	profit=sp-cp;
	per=(profit*100)/(cp);
	printf("%d percent",per);
}
    else if(sp<cp)
   { loss=cp-sp;
    per=(loss*100)/(cp);
    printf("%d percent",per);
   }
   else
   {printf("no profit no loss");
   }
	
	
}
