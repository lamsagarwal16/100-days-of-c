Q34: Write a program to check if a number is prime.
#include<stdio.h>
int main()
{ 
  int n,i,flag=0;
  printf("enter the number:\n");
  scanf("%d",&n);
  
  
  	for(i=2;i<=n-1;i++)
  	{
  		
  		if(n%i==0)
  		{ flag=1;
  		  break;
		  }
  		
	  }
  
  if(flag==1)
  printf(" not prime");
  else
  { printf("  prime");
  }
  
}
